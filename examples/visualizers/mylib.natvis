<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="mylib::point">
    <DisplayString>({x}, {y})</DisplayString>
  </Type>

  <Type Name="mylib::string">
    <DisplayString>{m_data,s8}</DisplayString>
    <StringView>m_data,s8</StringView>
    <Expand>
      <Item Name="[size]">m_length</Item>
    </Expand>
  </Type>

  <Type Name="mylib::vector&lt;*&gt;">
    <DisplayString>{{ size={m_size} }}</DisplayString>
    <Expand>
      <Item Name="[size]">m_size</Item>
      <Item Name="[capacity]">m_capacity</Item>
      <ArrayItems>
        <Size>m_size</Size>
        <ValuePointer>m_begin</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="mylib::optional&lt;*&gt;">
    <DisplayString Condition="!m_has_value">empty</DisplayString>
    <DisplayString>{*($T1*)m_storage}</DisplayString>
    <Expand>
      <Item Name="[value]" Condition="m_has_value">*($T1*)m_storage</Item>
    </Expand>
  </Type>

  <Type Name="mylib::list&lt;*&gt;">
    <DisplayString>{{ size={m_count} }}</DisplayString>
    <Expand>
      <LinkedListItems>
        <Size>m_count</Size>
        <HeadPointer>m_head</HeadPointer>
        <NextPointer>next</NextPointer>
        <ValueNode>value</ValueNode>
      </LinkedListItems>
    </Expand>
  </Type>

  <Type Name="mylib::int_map&lt;*&gt;">
    <DisplayString>{{ size={m_count} }}</DisplayString>
    <Expand>
      <TreeItems>
        <Size>m_count</Size>
        <HeadPointer>m_root</HeadPointer>
        <LeftPointer>left</LeftPointer>
        <RightPointer>right</RightPointer>
        <ValueNode Name="[{key}]">value</ValueNode>
      </TreeItems>
    </Expand>
  </Type>

  <!-- Walks the buckets, and each bucket's chain. Children are named by their keys. -->
  <Type Name="mylib::hash_map&lt;*&gt;">
    <DisplayString>{{ size={m_count} }}</DisplayString>
    <Expand>
      <Item Name="[bucket_count]">m_bucket_count</Item>
      <CustomListItems>
        <Variable Name="natvis_bucket" InitialValue="0" />
        <Variable Name="natvis_node" InitialValue="m_buckets[natvis_bucket]" />
        <Size>m_count</Size>
        <Loop>
          <Loop Condition="natvis_node != 0">
            <Item Name="[{natvis_node->key}]">natvis_node->value</Item>
            <Exec>natvis_node = natvis_node->next</Exec>
          </Loop>
          <Exec>++natvis_bucket</Exec>
          <Break Condition="natvis_bucket == m_bucket_count" />
          <Exec>natvis_node = m_buckets[natvis_bucket]</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <!-- Shows each entry as its value; tags: 0 none, 1 integer, 2 real. -->
  <Type Name="mylib::variant_array">
    <DisplayString>{{ size={m_size} }}</DisplayString>
    <Expand>
      <CustomListItems Condition="m_size != 0">
        <Variable Name="natvis_i" InitialValue="0" />
        <Variable Name="natvis_e" InitialValue="m_entries" />
        <Size Condition="m_size &lt;= m_capacity">m_size</Size>
        <Loop>
          <If Condition="natvis_i == m_size">
            <Break />
          </If>
          <If Condition="natvis_e->tag == 1">
            <Item>natvis_e->i</Item>
          </If>
          <Elseif Condition="natvis_e->tag == 2">
            <Item>natvis_e->d</Item>
          </Elseif>
          <Else>
            <Item Name="[{$i}] none" Condition="natvis_e->tag == 0">natvis_e->tag</Item>
          </Else>
          <Exec>++natvis_i, ++natvis_e</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

</AutoVisualizer>
